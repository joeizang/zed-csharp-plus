<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebSample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebSample.Core\WebSample.Core.csproj" />
    <EmbeddedResource Include="Persistence\Queries\*.sql" />
  </ItemGroup>

  <!-- Emit an updated revision file on every build. -->
  <Target Name="WriteRevision" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Writing revision for $(AssemblyName)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)revision.txt" Lines="$([System.DateTime]::Now.ToString(yyyyMMddHHmmss))" Overwrite="true" />
  </Target>

</Project>
